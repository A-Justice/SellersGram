rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return signedIn() && request.auth.uid == 'DSOWYy2niQZZtgkuogN2StnryTW2';
    }

    function isAdmin() {
      return isOwner() || (
        signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    match /users/{userId} {
      allow read: if true;
      allow create, update: if signedIn() && request.auth.uid == userId && (
        request.resource.data.role in ['seller', 'buyer'] || isOwner()
      );
      allow update: if isAdmin();

      match /interests/{listingId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }
    }

    match /listings/{userId} {
      allow read: if true;
      allow create, update: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow delete: if isAdmin() || (
        signedIn() && resource.data.sellerId == request.auth.uid
      );

      match /ads/{listingId} {
        allow read: if true;
        allow create: if isAdmin() || (
          signedIn()
          && request.auth.uid == userId
          && request.resource.data.sellerId == userId
          && (!('boostedUntil' in request.resource.data) || request.resource.data.boostedUntil == null)
        );
        allow update: if isAdmin() || (
          signedIn()
          && request.auth.uid == userId
          && (!('boostedUntil' in request.resource.data)
            || request.resource.data.boostedUntil == resource.data.boostedUntil)
        );
        allow delete: if isAdmin() || (signedIn() && request.auth.uid == userId);
      }
    }

    match /{path=**}/ads/{listingId} {
      allow read: if true;
    }

    match /threads/{threadId} {
      allow read, create: if signedIn();
      allow update, delete: if signedIn() && (
        isAdmin() ||
        request.auth.uid == resource.data.buyerId ||
        request.auth.uid == resource.data.sellerId
      );
      match /messages/{messageId} {
        allow read, create: if signedIn();
        allow update: if signedIn() && resource.data.fromUid == request.auth.uid;
        allow delete: if signedIn() && (
          isAdmin() ||
          resource.data.fromUid == request.auth.uid ||
          get(/databases/$(database)/documents/threads/$(threadId)).data.buyerId == request.auth.uid ||
          get(/databases/$(database)/documents/threads/$(threadId)).data.sellerId == request.auth.uid
        );
      }
    }

    match /reports/{reportId} {
      allow create: if signedIn();
      allow read, update, delete: if isAdmin() || signedIn();
    }

    match /notifications/{id} {
      allow read, update, delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.userId is string
        && request.resource.data.userId != request.auth.uid;
    }

    match /boostPackages/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /payments/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.sellerId == request.auth.uid);
      allow write: if false;
    }
  }
}
