rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return signedIn() && request.auth.uid == 'DSOWYy2niQZZtgkuogN2StnryTW2';
    }

    function isAdmin() {
      return isOwner() || (
        signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    match /users/{userId} {
      allow read: if true;
      allow create, update: if signedIn() && request.auth.uid == userId && (
        request.resource.data.role in ['seller', 'buyer'] || isOwner()
      );
      allow update: if isAdmin();
    }

    match /listings/{listingId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.sellerId == request.auth.uid;
      allow update, delete: if isAdmin() ||
        (signedIn() && resource.data.sellerId == request.auth.uid);
    }

    match /threads/{threadId} {
      allow read, create: if signedIn();
      match /messages/{messageId} {
        allow read, create: if signedIn();
      }
    }

    match /reports/{reportId} {
      allow create: if signedIn();
      allow read, update: if isAdmin();
    }

    match /boostPackages/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /payments/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.sellerId == request.auth.uid);
      allow write: if false;
    }
  }
}
